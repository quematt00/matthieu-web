# Hugo fingerprints the generated CSS and JavaScript URLs, so these can be
# cached indefinitely. The Font Awesome and other library styles/scripts are
# fingerprinted too; unversioned library fonts retain a shorter lifetime.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/lib/fontawesome-free/*
  Cache-Control: public, max-age=31536000, immutable

/lib/animate/*
  Cache-Control: public, max-age=31536000, immutable

/lib/autocomplete/*
  Cache-Control: public, max-age=31536000, immutable

/lib/fuse/*
  Cache-Control: public, max-age=31536000, immutable

/lib/webfonts/*
  Cache-Control: public, max-age=2592000, must-revalidate

/lib/lightgallery/*
  Cache-Control: public, max-age=2592000, must-revalidate

/lib/katex/*
  Cache-Control: public, max-age=2592000, must-revalidate

# The self-hosted Lato filenames include the upstream release version.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Responsive image filenames encode their size and format but may be replaced
# during future editorial updates, so they deliberately keep a shorter policy.
/images/*
  Cache-Control: public, max-age=2592000, must-revalidate
