{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- $pages := where .Pages "Sitemap.Disable" "ne" true -}}
  {{- $pages = where $pages "Kind" "not in" (slice "taxonomy" "term") -}}
  {{- range $pages -}}
  {{- $robots := lower (.Params.robots | default "") -}}
  {{- if and .Permalink (not (in $robots "noindex")) }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML (.Lastmod.Format "2006-01-02T15:04:05-07:00") }}</lastmod>{{ end }}{{ with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>{{ end }}{{ if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>{{ end }}{{ range .Translations }}{{ $altRobots := lower (.Params.robots | default "") }}{{ if not (in $altRobots "noindex") }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.LanguageCode }}" href="{{ .Permalink }}"/>{{ end }}{{ end }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.LanguageCode }}" href="{{ .Permalink }}"/>
    {{- $xdefault := . -}}
    {{- with index (where .AllTranslations "Language.Lang" "en") 0 -}}
      {{- $xdefault = . -}}
    {{- end -}}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ $xdefault.Permalink }}"/>
  </url>{{ end }}{{ end }}
</urlset>
